#!/usr/bin/env node

// Linux compatibility layer for the macOS chrome-cli commands used by send-prompt.
// It talks to Chrome through the Chrome DevTools Protocol (CDP).

const http = require('node:http');
const path = require('node:path');
const os = require('node:os');
const fs = require('node:fs');
const { spawn } = require('node:child_process');

const HOST = process.env.SEND_PROMPT_CHROME_HOST || '127.0.0.1';
const PORT = Number(process.env.SEND_PROMPT_CHROME_PORT || 9222);
const PROFILE = process.env.SEND_PROMPT_CHROME_PROFILE ||
  path.join(os.homedir(), '.local', 'share', 'send-prompt', 'chrome-profile');

function httpJson(pathname, method = 'GET') {
  return new Promise((resolve, reject) => {
    const request = http.request({ host: HOST, port: PORT, path: pathname, method }, response => {
      let body = '';
      response.setEncoding('utf8');
      response.on('data', chunk => { body += chunk; });
      response.on('end', () => {
        if (response.statusCode < 200 || response.statusCode >= 300) {
          reject(new Error(`Chrome returned HTTP ${response.statusCode}: ${body}`));
          return;
        }
        try {
          resolve(JSON.parse(body));
        } catch (error) {
          reject(new Error(`Invalid response from Chrome: ${error.message}`));
        }
      });
    });
    request.on('error', reject);
    request.end();
  });
}

async function browserIsReady() {
  try {
    await httpJson('/json/version');
    return true;
  } catch {
    return false;
  }
}

async function ensureBrowser() {
  if (await browserIsReady()) return;

  fs.mkdirSync(PROFILE, { recursive: true });
  const candidates = [
    process.env.SEND_PROMPT_CHROME_BIN,
    'google-chrome-stable',
    'google-chrome',
    'chromium',
    'chromium-browser'
  ].filter(Boolean);
  const browser = candidates[0];

  const child = spawn(browser, [
    `--remote-debugging-address=${HOST}`,
    `--remote-debugging-port=${PORT}`,
    `--user-data-dir=${PROFILE}`,
    '--no-first-run',
    '--no-default-browser-check'
  ], { detached: true, stdio: 'ignore' });
  child.unref();

  const deadline = Date.now() + 10000;
  while (Date.now() < deadline) {
    if (await browserIsReady()) return;
    await new Promise(resolve => setTimeout(resolve, 200));
  }
  throw new Error(
    `Could not connect to Chrome on ${HOST}:${PORT}. ` +
    `Set SEND_PROMPT_CHROME_BIN if Chrome is installed under another name.`
  );
}

async function listTargets() {
  await ensureBrowser();
  const targets = await httpJson('/json/list');
  return targets.filter(target => target.type === 'page');
}

async function cdp(target, method, params = {}) {
  const socket = new WebSocket(target.webSocketDebuggerUrl);
  let nextId = 1;

  return new Promise((resolve, reject) => {
    const timer = setTimeout(() => {
      try { socket.close(); } catch {}
      reject(new Error(`Timed out waiting for Chrome command ${method}`));
    }, 30000);

    socket.addEventListener('open', () => {
      socket.send(JSON.stringify({ id: nextId, method, params }));
    });
    socket.addEventListener('message', event => {
      const message = JSON.parse(event.data);
      if (message.id !== nextId) return;
      clearTimeout(timer);
      try { socket.close(); } catch {}
      if (message.error) reject(new Error(message.error.message));
      else resolve(message.result || {});
    });
    socket.addEventListener('error', error => {
      clearTimeout(timer);
      reject(error.error || error);
    });
  });
}

async function browserCdp(method, params = {}) {
  const version = await httpJson('/json/version');
  return cdp({ webSocketDebuggerUrl: version.webSocketDebuggerUrl }, method, params);
}

async function targetById(id) {
  const targets = await listTargets();
  const target = targets.find(item => item.id === id);
  if (!target) throw new Error(`Chrome tab not found: ${id}`);
  return target;
}

async function waitForNavigation(targetId, previousUrl) {
  const deadline = Date.now() + 3000;
  while (Date.now() < deadline) {
    const target = (await listTargets()).find(item => item.id === targetId);
    if (target && target.url !== previousUrl) return target;
    await new Promise(resolve => setTimeout(resolve, 100));
  }
  return targetById(targetId);
}

function output(value) {
  process.stdout.write(`${JSON.stringify(value)}\n`);
}

async function main() {
  const args = process.argv.slice(2);
  const command = args.shift();

  if (!command || command === '--help' || command === '-h') {
    console.log('Linux chrome-cli compatibility layer');
    console.log('Supported: list tabs, open, info, activate, execute');
    return;
  }

  if (command === 'list' && args[0] === 'tabs') {
    const tabs = await listTargets();
    output({ tabs: tabs.map(tab => ({
      id: tab.id,
      title: tab.title || '',
      url: tab.url || '',
      windowId: tab.id
    })) });
    return;
  }

  if (command === 'open') {
    const url = args.find(arg => !arg.startsWith('-'));
    const targetIdIndex = args.indexOf('-t');
    const targetId = targetIdIndex >= 0 ? args[targetIdIndex + 1] : null;
    if (!url) throw new Error('Usage: chrome-cli open <url> [-t <tab-id>]');

    let target;
    if (targetId) {
      target = await targetById(targetId);
      const previousUrl = target.url;
      await cdp(target, 'Page.navigate', { url });
      target = await waitForNavigation(target.id, previousUrl);
    } else {
      const created = await browserCdp('Target.createTarget', { url: 'about:blank' });
      target = await targetById(created.targetId);
      await cdp(target, 'Page.navigate', { url });
      target = await waitForNavigation(target.id, 'about:blank');
    }
    output({ id: target.id, title: target.title || '', url, loading: true });
    return;
  }

  const targetIdIndex = args.indexOf('-t');
  const targetId = targetIdIndex >= 0 ? args[targetIdIndex + 1] : null;

  if (command === 'info') {
    if (!targetId) throw new Error('Usage: chrome-cli info -t <tab-id>');
    const target = await targetById(targetId);
    const result = await cdp(target, 'Runtime.evaluate', {
      expression: '({ title: document.title, url: location.href, loading: document.readyState !== "complete" })',
      returnByValue: true,
      awaitPromise: true
    });
    output({ id: target.id, ...(result.result?.value || {}) });
    return;
  }

  if (command === 'activate') {
    if (!targetId) throw new Error('Usage: chrome-cli activate -t <tab-id>');
    const target = await targetById(targetId);
    await cdp(target, 'Page.bringToFront');
    output({ id: target.id });
    return;
  }

  if (command === 'execute') {
    if (!targetId) throw new Error('Usage: chrome-cli execute <javascript> -t <tab-id>');
    const expression = args.slice(0, targetIdIndex >= 0 ? targetIdIndex : args.length).join(' ');
    const target = await targetById(targetId);
    const result = await cdp(target, 'Runtime.evaluate', {
      expression,
      returnByValue: true,
      awaitPromise: true,
      userGesture: true
    });
    output(result.result?.value ?? null);
    return;
  }

  throw new Error(`Unsupported command: ${[command, ...args].join(' ')}`);
}

main().catch(error => {
  console.error(`chrome-cli: ${error.message}`);
  process.exit(1);
});
